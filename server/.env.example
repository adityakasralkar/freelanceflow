PORT=5001
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=freelanceflow
DB_USER=ff_user
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=your_secret_key_here
JWT_EXPIRES_IN=7d

# Frontend / public app URL
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5173

# Email (Resend) — leave RESEND_API_KEY blank in dev to log emails to console instead
RESEND_API_KEY=
EMAIL_FROM=FreelanceFlow <onboarding@resend.dev>
